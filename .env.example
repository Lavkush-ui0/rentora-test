# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Local or MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/rentora?retryWrites=true&w=majority

# JWT Token Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_me_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_me_in_production

# Client Application URL
CLIENT_URL=http://localhost:5173

# Cloudinary Credentials (For Listing Image Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Domain Restriction (Leave empty to allow any student email domain)
ALLOWED_EMAIL_DOMAIN=niet.co.in

# Web Push (VAPID) Credentials for Offline Notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@rentora.org.in
